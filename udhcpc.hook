#!/bin/sh
# Hook script for udhcpc
# Copyright (c) 2008 Natanael Copa <natanael.copa@gmail.com>
# Augmented by Fabian Mastenbroek <mail.fabianm@gmail.com>

export broadcast
export dns
export domain
export interface
export ip
export mask
export metric
export staticroutes
export router
export subnet

export PATH="${IPTV_COMMAND_PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

# Keep routes installed by this hook identifiable and, when configured,
# outside the main routing table. A dedicated table prevents an IPTV DHCP
# lease from becoming the gateway's system-wide default route.
IPTV_ROUTE_TABLE="${IPTV_ROUTE_TABLE:-main}"
IPTV_ROUTE_PROTOCOL="${IPTV_ROUTE_PROTOCOL:-99}"
IPTV_ALLOW_MAIN_DEFAULT_ROUTE="${IPTV_ALLOW_MAIN_DEFAULT_ROUTE:-false}"

# Use busybox if iproute2 is not installed
if ! command -v ip > /dev/null 2>&1; then
    alias ip="busybox ip"
fi

run_scripts() {
    local dir=$1
    if [ -d $dir ]; then
        for i in $dir/*; do
            [ -f $i ] && $i
        done
    fi
}

deconfig() {
    route_flush_managed
    ip -4 addr flush dev "$interface"
}

route_table_is_main() {
    case "$IPTV_ROUTE_TABLE" in
        "" | main | 254) return 0 ;;
        *) return 1 ;;
    esac
}

route_replace() {
    if route_table_is_main; then
        ip -4 route replace "$@" proto "$IPTV_ROUTE_PROTOCOL"
    else
        ip -4 route replace table "$IPTV_ROUTE_TABLE" "$@" proto "$IPTV_ROUTE_PROTOCOL"
    fi
}

route_flush_managed() {
    if route_table_is_main; then
        ip -4 route flush proto "$IPTV_ROUTE_PROTOCOL" dev "$interface" 2>/dev/null || true
    else
        ip -4 route flush table "$IPTV_ROUTE_TABLE" proto "$IPTV_ROUTE_PROTOCOL" dev "$interface" 2>/dev/null || true
    fi
}

route_copy_connected() {
    route_table_is_main && return

    local connected
    connected=$(ip -4 route show dev "$interface" scope link | awk 'NR == 1 { print $1 }')
    if [ -n "$connected" ]; then
        route_replace "$connected" dev "$interface" scope link src "$ip"
    fi
}

if_index() {
    if [ -e /sys/class/net/"$interface"/ifindex ]; then
        cat /sys/class/net/"$interface"/ifindex
    else
        ip -4 link show dev "$interface" | head -n1 | cut -d: -f1
    fi
}

calc_metric() {
    echo $((200 + $(if_index)))
}

route_add() {
    local to=$1 gw=$2 num=$3

    case "$to" in
        default | 0.0.0.0 | 0.0.0.0/0)
            if route_table_is_main && [ "$IPTV_ALLOW_MAIN_DEFAULT_ROUTE" != "true" ]; then
                echo "Ignoring IPTV DHCP default route on $interface; configure a dedicated IPTV_ROUTE_TABLE or explicitly set IPTV_ALLOW_MAIN_DEFAULT_ROUTE=true" >&2
                return 0
            fi
            to="default"
            ;;
    esac

    # special case for /32 subnets:
    # /32 instructs kernel to always use routing for all outgoing packets
    # (they can never be sent to local subnet - there is no local subnet for /32).
    # Used in datacenters, avoids the need for private ip-addresses between two hops.
    if [ "$subnet" = "255.255.255.255" ]; then
        route_replace "$gw" dev "$interface" scope link
    fi
    route_replace "$to" via "$gw" dev "$interface" onlink \
        metric $((num + ${IF_METRIC:-$(calc_metric)}))
}

routes() {
    [ -z "$router" ] && [ -z "$staticroutes" ] && return
    for i in $NO_GATEWAY; do
        [ "$i" = "$interface" ] && return
    done
    route_flush_managed
    route_copy_connected
    local num=0
    # RFC3442:
    # If the DHCP server returns both a Classless Static Routes option
    # and a Router option, the DHCP client MUST ignore the Router option.
    if [ -n "$staticroutes" ]; then
        # static routes format: dest1/mask gw1 ... destn/mask gwn
        set -- $staticroutes
        while [ -n "$1" ] && [ -n "$2" ]; do
            local dest="$1" gw="$2"
            if [ "$gw" = "0.0.0.0" ]; then
                route_replace "$dest" dev "$interface" scope link \
                    metric $((num + ${IF_METRIC:-$(calc_metric)})) && num=$((num + 1))
            else
                route_add $dest $gw $num && num=$(($num + 1))
            fi
            shift 2
        done
    else
        local gw=
        for gw in $router; do
            route_add 0.0.0.0/0 $gw $num && num=$(($num + 1))
        done
    fi
}

bound() {
    ip -4 addr add $ip/$mask ${broadcast:+broadcast $broadcast} dev $interface
    ip -4 link set dev $interface up
    routes
}

renew() {
    if ! ip -4 addr show dev $interface | grep $ip/$mask; then
        ip -4 addr flush dev $interface
        ip -4 addr add $ip/$mask ${broadcast:+broadcast $broadcast} dev $interface
    fi

    routes
}

case "$1" in
deconfig | renew | bound)
    $1
    ;;
leasefail)
    echo "udhcpc failed to get a DHCP lease" >&2
    ;;
nak)
    echo "udhcpc received DHCP NAK" >&2
    ;;
*)
    echo "Error: this script should be called from udhcpc" >&2
    exit 1
    ;;
esac
exit 0
