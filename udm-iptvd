set -e

# Default options
IPTV_WAN_VLAN_INTERFACE="${IPTV_WAN_VLAN_INTERFACE:-iptv}"
IPTV_WAN_DHCP_OPTIONS="${IPTV_WAN_DHCP_OPTIONS:-"-O staticroutes -V IPTV_RG"}"
IPTV_LAN_RANGES="${IPTV_LAN_RANGES:-""}"
IPTV_ROUTE_TABLE="${IPTV_ROUTE_TABLE:-main}"
IPTV_ROUTE_PROTOCOL="${IPTV_ROUTE_PROTOCOL:-99}"
IPTV_STATIC_ROUTE_PROTOCOL="${IPTV_STATIC_ROUTE_PROTOCOL:-100}"
IPTV_ROUTE_RULE_PRIORITY="${IPTV_ROUTE_RULE_PRIORITY:-18500}"
IPTV_ALLOW_MAIN_DEFAULT_ROUTE="${IPTV_ALLOW_MAIN_DEFAULT_ROUTE:-false}"
IPTV_NAT_ENABLE="${IPTV_NAT_ENABLE:-true}"
IPTV_NAT_SOURCE_RANGES="${IPTV_NAT_SOURCE_RANGES:-""}"
IPTV_ALLOW_UNSCOPED_NAT="${IPTV_ALLOW_UNSCOPED_NAT:-false}"

export IPTV_ROUTE_TABLE
export IPTV_ROUTE_PROTOCOL
export IPTV_ALLOW_MAIN_DEFAULT_ROUTE

POLICY_STATE_FILE="${IPTV_POLICY_STATE_FILE:-/var/run/udm-iptv.policy-rules}"
NAT_STATE_FILE="${IPTV_NAT_STATE_FILE:-/var/run/udm-iptv.nat-rules}"
IGMPPROXY_CONFIG_FILE="${IPTV_IGMPPROXY_CONFIG_FILE:-/var/run/igmpproxy.iptv.conf}"

# Use busybox if udhcpc is not installed directly
if ! command -v udhcpc > /dev/null 2>&1; then
    alias udhcpc="busybox udhcpc"
fi

_target_interface() {
    if [ "$IPTV_WAN_VLAN" -gt 0 ]; then
        echo "$IPTV_WAN_VLAN_INTERFACE"
    else
        echo "$IPTV_WAN_INTERFACE"
    fi
}

_route_table_is_main() {
    case "$IPTV_ROUTE_TABLE" in
        "" | main | 254) return 0 ;;
        *) return 1 ;;
    esac
}

_route_replace() {
    if _route_table_is_main; then
        ip -4 route replace "$@"
    else
        ip -4 route replace table "$IPTV_ROUTE_TABLE" "$@"
    fi
}

_route_flush_managed() {
    local target
    target="$(_target_interface)"

    if _route_table_is_main; then
        ip -4 route flush proto "$IPTV_ROUTE_PROTOCOL" dev "$target" 2>/dev/null || true
        ip -4 route flush proto "$IPTV_STATIC_ROUTE_PROTOCOL" dev "$target" 2>/dev/null || true
    else
        ip -4 route flush table "$IPTV_ROUTE_TABLE" proto "$IPTV_ROUTE_PROTOCOL" dev "$target" 2>/dev/null || true
        ip -4 route flush table "$IPTV_ROUTE_TABLE" proto "$IPTV_STATIC_ROUTE_PROTOCOL" dev "$target" 2>/dev/null || true
    fi
}

_contains_default_range() {
    local range
    for range in $IPTV_WAN_RANGES; do
        case "$range" in
            default | 0.0.0.0 | 0.0.0.0/0) return 0 ;;
        esac
    done
    return 1
}

_validate_configuration() {
    local failed=false interface

    if [ -z "$IPTV_WAN_INTERFACE" ]; then
        echo "error: IPTV_WAN_INTERFACE must not be empty" >&2
        failed=true
    elif ! ip link show "$IPTV_WAN_INTERFACE" >/dev/null 2>&1; then
        echo "error: IPTV WAN interface $IPTV_WAN_INTERFACE does not exist" >&2
        failed=true
    fi

    case "$IPTV_WAN_VLAN" in
        "" | *[!0-9]*)
            echo "error: IPTV_WAN_VLAN must be a non-negative integer" >&2
            failed=true
            ;;
        *)
            if [ "$IPTV_WAN_VLAN" -gt 4094 ]; then
                echo "error: IPTV_WAN_VLAN must be between 0 and 4094" >&2
                failed=true
            fi
            ;;
    esac

    if ! _route_table_is_main; then
        case "$IPTV_ROUTE_TABLE" in
            *[!0-9]* | "")
                echo "error: IPTV_ROUTE_TABLE must be a dedicated numeric table from 1 to 252" >&2
                failed=true
                ;;
            *)
                if [ "$IPTV_ROUTE_TABLE" -lt 1 ] || [ "$IPTV_ROUTE_TABLE" -gt 252 ]; then
                    echo "error: IPTV_ROUTE_TABLE must be a dedicated numeric table from 1 to 252" >&2
                    failed=true
                fi
                ;;
        esac
        case "$IPTV_ROUTE_RULE_PRIORITY" in
            *[!0-9]* | "")
                echo "error: IPTV_ROUTE_RULE_PRIORITY must be a positive integer" >&2
                failed=true
                ;;
            *)
                if [ "$IPTV_ROUTE_RULE_PRIORITY" -lt 1 ] || [ "$IPTV_ROUTE_RULE_PRIORITY" -gt 32765 ]; then
                    echo "error: IPTV_ROUTE_RULE_PRIORITY must be between 1 and 32765" >&2
                    failed=true
                fi
                ;;
        esac
        if [ -z "$IPTV_LAN_INTERFACES" ]; then
            echo "error: IPTV_LAN_INTERFACES must not be empty when isolated routing is enabled" >&2
            failed=true
        else
            for interface in $IPTV_LAN_INTERFACES; do
                if ! ip link show "$interface" >/dev/null 2>&1; then
                    echo "error: IPTV LAN interface $interface does not exist" >&2
                    failed=true
                fi
            done
        fi
    fi

    if [ "$IPTV_NAT_ENABLE" = "true" ] && _contains_default_range &&
       [ -z "$IPTV_NAT_SOURCE_RANGES" ] && [ "$IPTV_ALLOW_UNSCOPED_NAT" != "true" ]; then
        echo "error: refusing unscoped IPTV NAT for 0.0.0.0/0; set IPTV_NAT_SOURCE_RANGES or explicitly opt in with IPTV_ALLOW_UNSCOPED_NAT=true" >&2
        failed=true
    fi

    if _route_table_is_main && [ "$IPTV_ALLOW_MAIN_DEFAULT_ROUTE" = "true" ]; then
        echo "warning: IPTV DHCP is allowed to install a default route in the main table" >&2
    fi

    [ "$failed" = "false" ]
}

_policy_teardown() {
    local priority interface table

    if [ -f "$POLICY_STATE_FILE" ]; then
        while read -r priority interface table; do
            [ -n "$priority" ] || continue
            while ip -4 rule del priority "$priority" iif "$interface" lookup "$table" 2>/dev/null; do
                :
            done
        done < "$POLICY_STATE_FILE"
        rm -f "$POLICY_STATE_FILE"
    fi

    ip -4 route flush cache 2>/dev/null || true
}

_policy_setup() {
    _policy_teardown
    _route_table_is_main && return

    local priority interface
    priority="$IPTV_ROUTE_RULE_PRIORITY"
    : > "$POLICY_STATE_FILE"
    for interface in $IPTV_LAN_INTERFACES; do
        if ! ip link show "$interface" >/dev/null 2>&1; then
            echo "error: IPTV LAN interface $interface does not exist" >&2
            return 1
        fi
        ip -4 rule add priority "$priority" iif "$interface" lookup "$IPTV_ROUTE_TABLE"
        echo "$priority $interface $IPTV_ROUTE_TABLE" >> "$POLICY_STATE_FILE"
        priority=$((priority + 1))
    done
    ip -4 route flush cache 2>/dev/null || true
}

_nat_rule_exists() {
    local target=$1 range=$2 source=$3
    if [ -n "$source" ]; then
        iptables -C POSTROUTING -t nat -s "$source" -d "$range" -j MASQUERADE -o "$target" >/dev/null 2>&1
    else
        iptables -C POSTROUTING -t nat -d "$range" -j MASQUERADE -o "$target" >/dev/null 2>&1
    fi
}

_nat_rule_add() {
    local target=$1 range=$2 source=$3
    _nat_rule_exists "$target" "$range" "$source" && return
    if [ -n "$source" ]; then
        iptables -A POSTROUTING -t nat -s "$source" -d "$range" -j MASQUERADE -o "$target"
    else
        iptables -A POSTROUTING -t nat -d "$range" -j MASQUERADE -o "$target"
    fi
}

_nat_rule_delete() {
    local target=$1 range=$2 source=$3
    while _nat_rule_exists "$target" "$range" "$source"; do
        if [ -n "$source" ]; then
            iptables -D POSTROUTING -t nat -s "$source" -d "$range" -j MASQUERADE -o "$target"
        else
            iptables -D POSTROUTING -t nat -d "$range" -j MASQUERADE -o "$target"
        fi
    done
}

_nat_setup() {
    _nat_teardown
    [ "$IPTV_NAT_ENABLE" = "true" ] || return

    local target range source
    target="$(_target_interface)"
    : > "$NAT_STATE_FILE"
    for range in $IPTV_WAN_RANGES; do
        if [ -n "$IPTV_NAT_SOURCE_RANGES" ]; then
            # Remove the destination-only rule used by releases before scoped
            # NAT was introduced. This is limited to the IPTV egress device.
            _nat_rule_delete "$target" "$range" ""
            for source in $IPTV_NAT_SOURCE_RANGES; do
                _nat_rule_add "$target" "$range" "$source"
                echo "$target $range $source" >> "$NAT_STATE_FILE"
            done
        else
            _nat_rule_add "$target" "$range" ""
            echo "$target $range -" >> "$NAT_STATE_FILE"
        fi
    done
}

_nat_teardown() {
    local target range source

    if [ -f "$NAT_STATE_FILE" ]; then
        while read -r target range source; do
            [ -n "$target" ] || continue
            if [ "$source" = "-" ]; then
                source=""
            fi
            _nat_rule_delete "$target" "$range" "$source"
        done < "$NAT_STATE_FILE"
        rm -f "$NAT_STATE_FILE"
        return
    fi

    [ "$IPTV_NAT_ENABLE" = "true" ] || return

    target="$(_target_interface)"
    for range in $IPTV_WAN_RANGES; do
        if [ -n "$IPTV_NAT_SOURCE_RANGES" ]; then
            for source in $IPTV_NAT_SOURCE_RANGES; do
                _nat_rule_delete "$target" "$range" "$source"
            done
        else
            _nat_rule_delete "$target" "$range" ""
        fi
    done
}

# Setup the network, creating the IPTV VLAN interface if necessary
# and obtaining an IP address for the interface.
_network_setup() {
    local target
    target="$IPTV_WAN_INTERFACE"

    _validate_configuration

    # Make sure we obtain IP address for VLAN interface
    if [ "$IPTV_WAN_VLAN" -gt 0 ]; then
        target="$IPTV_WAN_VLAN_INTERFACE"

        if ! ip link show "$IPTV_WAN_INTERFACE" >/dev/null; then
            echo "Device $IPTV_WAN_INTERFACE for $IPTV_WAN_VLAN_INTERFACE does not exist"
            exit 1
        fi

        # Delete existing VLAN interface
        if ip link show "$IPTV_WAN_VLAN_INTERFACE" >/dev/null 2>&1; then
            echo "Device $IPTV_WAN_VLAN_INTERFACE already exists.. Deleting device"
            ip link delete dev "$IPTV_WAN_VLAN_INTERFACE"
        fi

        ip link add link "$IPTV_WAN_INTERFACE" name "$IPTV_WAN_VLAN_INTERFACE" type vlan id "$IPTV_WAN_VLAN"

        # Specify custom MAC address for VLAN interface
        if [ -n "$IPTV_WAN_VLAN_MAC" ]; then
            ip link set dev "$IPTV_WAN_VLAN_INTERFACE" address "$IPTV_WAN_VLAN_MAC"
        fi

        # Bring VLAN interface up
        ip link set dev "$IPTV_WAN_VLAN_INTERFACE" up

        _route_flush_managed

        if [ "$IPTV_WAN_DHCP" != "false" ]; then
            echo "Obtaining IP address for VLAN interface"

            # Obtain IP address for VLAN interface
            udhcpc -b -R -p /var/run/udhcpc."$IPTV_WAN_VLAN_INTERFACE".pid -s "$(dirname "$0")"/udhcpc.hook -i "$IPTV_WAN_VLAN_INTERFACE" $IPTV_WAN_DHCP_OPTIONS
        fi
    fi

    if [ "$IPTV_WAN_DHCP" = "false" ] && [ -n "$IPTV_WAN_STATIC_IP" ]; then
        ip -4 addr change "$IPTV_WAN_STATIC_IP" dev "$target"
    fi

    _policy_setup

    echo "NATing IPTV network ranges (if necessary)"
    _nat_setup

    echo "Creating static routes (if necessary)"
    for range in $IPTV_STATIC_ROUTES; do
        _route_replace "$range" dev "$target" proto "$IPTV_STATIC_ROUTE_PROTOCOL"
    done
}

# Watch for network changes and re-apply the configuration
_network_watch() {
    if [ "$IPTV_WAN_VLAN" -gt 0 ]; then
        return
    fi

    echo "Monitoring interface $IPTV_WAN_INTERFACE for changes"

    # Monitor for changes on the WAN interface
    ip monitor address dev "$IPTV_WAN_INTERFACE" | while read line; do
        if echo "$line" | grep -q "Deleted"; then
            _network_setup
        fi
    done & # Monitoring happens in background
}

# Tear down the network configuration
_network_teardown() {
    _nat_teardown
    _policy_teardown
    _route_flush_managed

    if [ "$IPTV_WAN_VLAN" -gt 0 ] && ip link show "$IPTV_WAN_VLAN_INTERFACE" >/dev/null 2>&1; then
        ip link delete dev "$IPTV_WAN_VLAN_INTERFACE"
    fi
}

# Build the configuration needed by IGMP Proxy
_igmpproxy_build_config() {
    echo "# igmpproxy configuration for udm-iptv"
    if [ -z "$IPTV_IGMPPROXY_DISABLE_QUICKLEAVE" ] || [ "$IPTV_IGMPPROXY_DISABLE_QUICKLEAVE" = "false" ]; then
        echo "quickleave"
    fi

    local target
    if [ "$IPTV_WAN_VLAN" -gt 0 ]; then
        target="$IPTV_WAN_VLAN_INTERFACE"
    else
        target="$IPTV_WAN_INTERFACE"
    fi

    echo "phyint $target upstream  ratelimit 0  threshold 1"
    for range in $IPTV_LAN_RANGES $IPTV_WAN_RANGES; do
        echo "  altnet $range"
    done

    # Configure the igmpproxy interfaces
    for path in /sys/class/net/*; do
        local interface
        interface=$(basename "$path")
        if echo "$IPTV_LAN_INTERFACES" | grep -w -q "$interface"; then
            echo "phyint $interface downstream  ratelimit 0  threshold 1"
        elif [ "$interface" != "lo" ] && [ "$interface" != "$target" ]; then
            echo "phyint $interface disabled"
        fi
    done
}

# Build the configuration needed by IMProxy
_igmpproxy_build_config_improxy() {
    echo "# improxy configuration for udm-iptv"
    if [ "$IPTV_IGMPPROXY_IGMP_VERSION" = 3 ]; then
        echo "igmp enable version 3"
    else
        echo "igmp enable version 2"
    fi

    echo "mld disable"

    if [ "$IPTV_IGMPPROXY_DISABLE_QUICKLEAVE" = "false" ]; then
        echo "quickleave enable"
    else
        echo "quickleave disable"
    fi

    local target
    if [ "$IPTV_WAN_VLAN" -gt 0 ]; then
        target="$IPTV_WAN_VLAN_INTERFACE"
    else
        target="$IPTV_WAN_INTERFACE"
    fi

    echo "upstream $target"

    # Configure the upstream interfaces
    for path in /sys/class/net/*; do
        local interface
        interface=$(basename "$path")
        if echo "$IPTV_LAN_INTERFACES" | grep -w -q "$interface"; then
            echo "downstream $interface"
        fi
    done
}

# Configure IGMP Proxy to bridge multicast traffic
_igmpproxy_setup() {
    echo "Setting up IGMP Proxy"

    if [ "$IPTV_IGMPPROXY_PROGRAM" = "improxy" ]; then
        echo "Using improxy..."
        _igmpproxy_build_config_improxy > "$IGMPPROXY_CONFIG_FILE"
    else
        echo "Using igmpproxy..."
        _igmpproxy_build_config > "$IGMPPROXY_CONFIG_FILE"
    fi
}

# Tear down the IGMP Proxy configuration
_igmpproxy_teardown() {
    rm -f "$IGMPPROXY_CONFIG_FILE"
}

# Start the igmpproxy service
_igmpproxy_start() {
    echo "Starting IGMP Proxy"
    args=""
    if [ -n "$IPTV_IGMPPROXY_DEBUG" ] && [ "$IPTV_IGMPPROXY_DEBUG" != "false" ]; then
        if [ "$IPTV_IGMPPROXY_PROGRAM" = "improxy" ]; then
            args="-d 5"
        else
            args="-d -v"
        fi
    fi

    if [ "$IPTV_IGMPPROXY_PROGRAM" = "improxy" ]; then
        if ! command -v improxy > /dev/null 2>&1; then
            echo "error: improxy not installed..."
            exit 1
        fi

        # shellcheck disable=SC2086
        exec improxy $args "$@" -c "$IGMPPROXY_CONFIG_FILE"
    else
        if ! command -v igmpproxy > /dev/null 2>&1; then
            echo "error: igmpproxy not installed..."
            exit 1
        fi

        # shellcheck disable=SC2086
        exec igmpproxy -n $args "$@" "$IGMPPROXY_CONFIG_FILE"
    fi
}


# Check if the user passed any argument
if [ $# -eq 0 ]; then
    exit 1
fi

case $1 in
    validate)
        _validate_configuration
        ;;
    start)
        shift
        _network_setup
        _network_watch
        _igmpproxy_setup
        _igmpproxy_start "$@"
        ;;
    stop)
        shift
        _network_teardown
        _igmpproxy_teardown
        ;;
    *)
        exit 1
        ;;
esac
